node_modules/
dist/
storybook-static/
*.tsbuildinfo
.DS_Store
.worktrees/
# Ignore .claude/ EXCEPT for slash-command definitions, which we check in.
# Must use `.claude/*` (not `.claude/`) so the negation can re-include
# subdirectories — git can't un-ignore children of a fully-ignored dir.
.claude/*
!.claude/commands/
!.claude/commands/**
*.pdf

# Prevent stale compiled .js from shadowing .tsx sources
packages/*/src/**/*.js
!packages/*/src/primitives/**/*.js
!packages/*/src/scripts/**/*.js
giving-claude-eyes/
tmp-sb-index.json
build-storybook.log

# Figma sync-script build artifacts (generated from tokens/CVA sources)
packages/*/scripts/.figma/
playgrounds-review-*/
