# syntax=docker/dockerfile:1.7
# Builds the site's Cloudflare Workers bundle (.open-next) on Linux.
#
# Why this exists: OpenNext packages from Next's `standalone` output, and that
# tracer creates symlinks. Windows refuses them without Developer Mode
# (EPERM on every traced file), so the bundle cannot be produced on the host.
#
# Build context: repo root.
#   docker build -f Dockerfile.opennext --target output \
#     --output type=local,dest=<somewhere> .
# The `output` stage is FROM scratch, so the result is just the bundle.

# Debian, not Alpine: wrangler spawns the workerd binary during deploy, and
# @cloudflare/workerd-linux-64 is linked against glibc. On musl it fails with a
# bare `spawn ENOENT` even though the 157MB binary is present and executable.
FROM node:22-slim AS builder
WORKDIR /repo

ENV BUILD_STANDALONE=1
ENV NEXT_TELEMETRY_DISABLED=1

# workerd needs system CA certs for TLS; node:22-slim ships without them
# ("service internet: TLS configuration: ... No CA certificates were loaded").
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@latest --activate

# Manifests first so an edit to source doesn't bust the install layer.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/brand/package.json packages/brand/package.json
COPY apps/site/package.json apps/site/package.json
COPY .changeset/ .changeset/

RUN pnpm install --frozen-lockfile

COPY . .

# Site imports the built DS, so build the packages first.
RUN pnpm -F @devalok/shilp-sutra-brand build || true
RUN pnpm -F @devalok/shilp-sutra build
RUN pnpm -F site build

# Package for workerd. Next already built above.
RUN cd apps/site && pnpm exec opennextjs-cloudflare build --skipNextBuild

# ─── Export stage: nothing but the bundle ───────────────────────────
FROM scratch AS output
COPY --from=builder /repo/apps/site/.open-next /
