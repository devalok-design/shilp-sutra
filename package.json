{
  "name": "@devalok/shilp-sutra-workspace",
  "version": "0.4.0",
  "description": "Devalok Design System — tokens, components, and patterns for Next.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "turbo run build && node scripts/post-build-audit.mjs",
    "build:fresh": "turbo run build --force && node scripts/post-build-audit.mjs",
    "pre-publish-audit": "node scripts/pre-publish-audit.mjs",
    "build:core": "pnpm --filter @devalok/shilp-sutra build",
    "build:brand": "pnpm --filter @devalok/shilp-sutra-brand build",
    "build-storybook": "storybook build",
    "build:playground": "cd apps/playground && pnpm build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:props": "node scripts/check-props-exports.mjs",
    "gen:tools": "node scripts/generate-tool-list.mjs",
    "check:tools": "node scripts/generate-tool-list.mjs --check",
    "check:examples": "node packages/core/scripts/lint-doc-examples.mjs --check",
    "check:doc-props": "node scripts/audit-doc-props.mjs",
    "check:recipes": "node scripts/check-recipe-currency.mjs",
    "check:sizing": "node packages/core/scripts/check-arbitrary-sizing.mjs --check",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "analytics:report": "node scripts/posthog-report.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\"",
    "test": "turbo run test",
    "test:watch": "pnpm -r test:watch",
    "test:storybook": "vitest --project storybook",
    "test:storybook:ci": "vitest run --project storybook",
    "verify": "pnpm check:lockfile && pnpm build && pnpm typecheck && pnpm lint && pnpm lint:props && pnpm check:sizing && pnpm test && node packages/core/scripts/ssr-smoke-test.mjs && pnpm test:storybook:ci",
    "changeset": "changeset",
    "version-packages": "node scripts/changeset-version-retry.mjs && node scripts/prepend-breaking-summary.mjs && node scripts/stub-migration-section.mjs && node scripts/generate-tool-list.mjs && node scripts/sync-skill-version.mjs && node packages/core/scripts/build-component-docs.mjs && node packages/core/scripts/build-mcp-manifest.mjs && node scripts/build-skill.mjs",
    "release": "pnpm build:fresh && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.1",
    "@devalok/eslint-plugin-shilp-sutra": "workspace:*",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^0.5.0",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react": "10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time-format": "^4.0.3",
    "@types/d3-transition": "^3.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4",
    "chromatic": "^18.15.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.3.5",
    "turbo": "2.11.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "imports": {
    "#.storybook/*": "./.storybook/*"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devalok-design/shilp-sutra.git"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@typescript-eslint/rule-tester": "8.73.0",
      "esbuild@<0.28.1": "^0.28.1",
      "@hono/node-server@>=2.0.0 <2.1.6": "^2.1.6",
      "sharp@<0.35.0": "^0.35.0",
      "postcss@<8.5.12": "^8.5.12",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "hono@<4.13.16": "^4.13.16",
      "ip-address@>=10.0.0 <10.7.4": "^10.7.4",
      "body-parser@>=1.0.0 <1.20.9": "^1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "compression@<1.8.2": "^1.8.2",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "postcss-selector-parser@>=6.0.0 <6.1.5": "^6.1.5",
      "proxy-addr@>=2.0.0 <2.0.8": "^2.0.8",
      "qs@>=6.0.0 <6.16.1": "^6.16.1",
      "valibot@>=1.0.0 <1.4.2": "^1.4.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10",
        "@valibot/to-json-schema>valibot": "1"
      }
    }
  }
}
