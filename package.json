{
  "name": "@devalok/shilp-sutra-workspace",
  "version": "0.4.0",
  "description": "Devalok Design System — tokens, components, and patterns for Next.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "pnpm -r build && node scripts/post-build-audit.mjs",
    "pre-publish-audit": "node scripts/pre-publish-audit.mjs",
    "build:core": "pnpm --filter @devalok/shilp-sutra build",
    "build:brand": "pnpm --filter @devalok/shilp-sutra-brand build",
    "build-storybook": "storybook build",
    "build:playground": "cd apps/playground && pnpm build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:props": "node scripts/check-props-exports.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css}\"",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "test:storybook": "vitest --project storybook",
    "test:storybook:ci": "vitest run --project storybook",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm lint:props && pnpm test && node packages/core/scripts/ssr-smoke-test.mjs && pnpm test:storybook:ci",
    "changeset": "changeset",
    "version-packages": "node scripts/changeset-version-retry.mjs && node scripts/prepend-breaking-summary.mjs && node scripts/stub-migration-section.mjs && node scripts/sync-skill-version.mjs && node packages/core/scripts/build-component-docs.mjs && node packages/core/scripts/build-mcp-manifest.mjs && node scripts/build-skill.mjs",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-mcp": "^0.5.0",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react": "10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/postcss": "4",
    "@tailwindcss/vite": "4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-format": "^3.0.4",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.8",
    "@types/d3-time-format": "^4.0.3",
    "@types/d3-transition": "^3.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "4.1.4",
    "@vitest/browser-playwright": "4.1.4",
    "autoprefixer": "^10.5.0",
    "chromatic": "^16.3.0",
    "eslint": "^10.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4",
    "vitest-axe": "^0.1.0"
  },
  "imports": {
    "#.storybook/*": "./.storybook/*"
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devalok-design/shilp-sutra.git"
  },
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@typescript-eslint/rule-tester": "8.58.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@emoji-mart/react>react": "19",
        "@emoji-mart/react>react-dom": "19",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "@valibot/to-json-schema>valibot": "1"
      }
    }
  }
}
