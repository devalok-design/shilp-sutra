{
  "name": "@devalok/shilp-sutra-brand",
  "version": "0.7.0",
  "description": "Brand logos and SVG/PNG/WebP assets for the Devalok Design System (Devalok, Karm).",
  "license": "MIT",
  "author": "Devalok Design & Strategy Studios <shilp-sutra@devalok.in>",
  "homepage": "https://devalok-design.github.io/shilp-sutra/",
  "repository": {
    "type": "git",
    "url": "https://github.com/devalok-design/shilp-sutra",
    "directory": "packages/brand"
  },
  "bugs": {
    "url": "https://github.com/devalok-design/shilp-sutra/issues"
  },
  "keywords": [
    "react",
    "design-system",
    "logos",
    "brand-assets",
    "svg",
    "shilp-sutra",
    "devalok"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./devalok": {
      "import": "./dist/devalok/index.js",
      "types": "./dist/devalok/index.d.ts"
    },
    "./karm": {
      "import": "./dist/karm/index.js",
      "types": "./dist/karm/index.d.ts"
    },
    "./assets/*": "./dist/assets/*"
  },
  "files": [
    "dist",
    "README.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "vite build && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test:local": "vitest run",
    "lint": "eslint src/",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  }
}
