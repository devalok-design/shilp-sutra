{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "remoteCache": {
    "enabled": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "skill/**",
        "mcp-manifest.json",
        "AGENTS.md",
        "MIGRATION.md",
        ".next/**",
        "!.next/cache/**",
        "app/canvas-modes.css",
        "public/r/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["@devalok/eslint-plugin-shilp-sutra#build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
